<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.demo.supplychain</groupId>
    <artifactId>vulnerable-invoice-service</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Vulnerable Invoice Service (Demo)</name>
    <description>
        Deliberately-insecure Java/Maven sample used to demo the
        Dependency &amp; Supply-Chain Hygiene plugin. Every dependency block
        below is tagged with the detection category it is meant to trigger.
        DO NOT use any of these versions in real software.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <!-- ==========================================================
         ISSUE #5 — UNTRUSTED SOURCE
         A non-Maven-Central repository served over plain HTTP from an
         unverified host. Supply-chain audit must flag this.
         ========================================================== -->
    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>internal-untrusted-mirror</id>
            <name>Untrusted HTTP Mirror</name>
            <url>http://insecure-mirror.example.net/maven2</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>

        <!-- ==========================================================
             ISSUE #2 — KNOWN CVE / VULNERABLE DEPENDENCIES
             ========================================================== -->

        <!-- log4j bumped 2.14.1 → 2.25.4 (CVE-2021-44228/45046/45105 + GHSA-3pxv/vc5p/6hg6 cleared) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.25.4</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.25.4</version>
        </dependency>

        <!-- jackson-databind bumped 2.9.8 → 2.18.3 (CVE-2020-8840 + 53 others cleared) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.3</version>
        </dependency>

        <!-- guava bumped 24.1.1-jre → 33.4.0-jre (CVE-2023-2976 + CVE-2020-8908 cleared) -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.4.0-jre</version>
        </dependency>

        <!-- ==========================================================
             ISSUE #1 — OUTDATED (but not necessarily CVE) DEPENDENCIES
             Years behind current releases.
             ========================================================== -->
        <!-- commons-io bumped 2.4 → 2.18.0 (CVE-2024-47554 cleared) -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.18.0</version>
        </dependency>
        <!-- commons-lang3 bumped 3.4 → 3.18.0 (CVE-2025-48924 + GHSA-j288 cleared) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>

        <!-- ==========================================================
             ISSUE #3 — UNLICENSED / LICENSE-POLICY VIOLATION
             GPL-2.0 connector pulled into a permissive-only project.
             ========================================================== -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.30</version>
        </dependency>

        <!-- ISSUE #4 — TYPOSQUAT REMOVED by depscan auto-remediation:
             com.fastxml.jackson.core did not exist on Central (supply-chain attack). -->

        <!-- Test scope -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- ==========================================================
                 ISSUE #6 — TEST COVERAGE BELOW 80%
                 JaCoCo enforces a 0.80 line-coverage minimum. The shipped
                 tests intentionally cover only part of the code, so
                 `mvn verify` fails the gate.
                 ========================================================== -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
