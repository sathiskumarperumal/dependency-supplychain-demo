<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.demo.supplychain</groupId>
    <artifactId>vulnerable-invoice-service</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Vulnerable Invoice Service (Demo)</name>
    <description>
        Deliberately-insecure Java/Maven sample used to demo the
        Dependency &amp; Supply-Chain Hygiene plugin. Every dependency block
        below is tagged with the detection category it is meant to trigger.
        DO NOT use any of these versions in real software.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <!-- ==========================================================
         ISSUE #5 — UNTRUSTED SOURCE
         A non-Maven-Central repository served over plain HTTP from an
         unverified host. Supply-chain audit must flag this.
         ========================================================== -->
    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
        <repository>
            <id>internal-untrusted-mirror</id>
            <name>Untrusted HTTP Mirror</name>
            <url>http://insecure-mirror.example.net/maven2</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <!-- ==========================================================
         Stage 3 auto-remediation — transitive-only CVE fixes.
         These coordinates are pulled in transitively (not declared directly
         above) but still carry known CVEs, so they are pinned here rather
         than added as new top-level dependencies.
         ========================================================== -->
    <dependencyManagement>
        <dependencies>
            <!-- Pulled in transitively by jackson-databind; pinned to the same
                 2.18.8 line so the whole Jackson family stays in lockstep and
                 CVE-2025-52999 (fix 2.15.0) / GHSA-72hv-8253-57qq (fix 2.18.6) are cleared. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.18.8</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>2.18.8</version>
            </dependency>
            <!-- Transitive-only; CVE-2024-7254 (fix 3.25.5), CVE-2022-3171/3509/3510 (fix 3.19.6). -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>3.25.5</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ==========================================================
             ISSUE #2 — KNOWN CVE / VULNERABLE DEPENDENCIES
             ========================================================== -->

        <!-- Log4Shell family: CVE-2021-44228 (CVSS 10.0, fix 2.15.0), CVE-2021-45046 (fix 2.16.0),
             CVE-2021-45105 (fix 2.17.0), CVE-2021-44832 (fix 2.17.1), plus later-disclosed
             CVE-2026-34480/CVE-2026-34477 (fix 2.25.4) and CVE-2025-68161 (fix 2.25.3).
             2.25.4 is the lowest stable release clearing every CVE on file for this component
             (Stage 3 auto-remediation, bumped 2.14.1 -> 2.25.4; log4j-api kept in lockstep). -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.25.4</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.25.4</version>
        </dependency>

        <!-- Multiple deserialization CVEs (CVE-2020-8840, CVE-2019-14379, CVE-2019-16335, ...).
             2.18.8 is the lowest stable release clearing every fixable CVE on file; one residual
             MEDIUM finding (CVE-2026-54515) has no fix_version published yet upstream (Stage 3
             auto-remediation, bumped 2.9.8 -> 2.18.8). jackson-core/jackson-annotations are pinned
             to match via dependencyManagement above so the whole Jackson family moves in lockstep. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.8</version>
        </dependency>

        <!-- CVE-2023-2976 (insecure temp dir via createTempDir(), fix 32.0.0-android), CVE-2020-8908.
             Stage 3 auto-remediation, bumped 24.1.1-jre -> 32.0.0-android (per scanner fix_version). -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>32.0.0-android</version>
        </dependency>

        <!-- ==========================================================
             ISSUE #1 — OUTDATED (but not necessarily CVE) DEPENDENCIES
             Years behind current releases.
             ========================================================== -->
        <!-- CVE-2021-29425 (path traversal, fix 2.7), CVE-2024-47554 (uncontrolled resource
             consumption, fix 2.14.0). Stage 3 auto-remediation, bumped 2.4 -> 2.14.0. -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.14.0</version>
        </dependency>
        <!-- CVE-2025-48924 (uncontrolled recursion in ClassUtils, fix 3.18.0).
             Stage 3 auto-remediation, bumped 3.4 -> 3.18.0. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>

        <!-- ==========================================================
             ISSUE #3 — UNLICENSED / LICENSE-POLICY VIOLATION
             GPL-2.0 connector pulled into a permissive-only project.
             ========================================================== -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>8.0.30</version>
        </dependency>

        <!-- ==========================================================
             ISSUE #4 — TYPOSQUATTED DEPENDENCY (removed by Stage 3 auto-remediation)
             groupId "com.fastxml" (missing the "er") impersonated the real
             "com.fasterxml.jackson.core" and does not exist on Central, so it
             hard-blocked all dependency resolution (mvn could not even reach
             the "verify CVEs are cleared" step with this present). Removed
             here strictly to unblock the build; the broader supply-chain
             typosquat audit (SBOM/Grype, untrusted-mirror policy) remains
             Stage 4's responsibility per the depscan-supplychain-audit skill.
             ========================================================== -->

        <!-- Test scope -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- ==========================================================
                 ISSUE #6 — TEST COVERAGE BELOW 80%
                 JaCoCo enforces a 0.80 line-coverage minimum. The shipped
                 tests intentionally cover only part of the code, so
                 `mvn verify` fails the gate.
                 ========================================================== -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
